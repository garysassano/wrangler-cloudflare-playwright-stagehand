{
  "name": "wrangler-cloudflare-playwright-stagehand",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm bundle",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^2.5.9",
    "@cloudflare/playwright": "^1.3.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
